#include "kernel_operator.h"

// A complete Ascend C kernel demonstrating:
// - __global__ kernel entry point
// - __aicore__ device methods
// - __aicpu__ host-side function
// - SDK data movement and compute APIs
// - GlobalTensor / LocalTensor usage
// - Tiling and synchronisation

class MatmulKernel {
public:
    __aicore__ inline void Init(
        __gm__ uint8_t* inputA,
        __gm__ uint8_t* inputB,
        __gm__ uint8_t* output,
        uint32_t M, uint32_t N, uint32_t K
    ) {
        this->M = M;
        this->N = N;
        this->K = K;

        uint32_t blockIdx = GetBlockIdx();
        uint32_t blockNum = GetBlockNum();

        aGlobal.SetGlobalBuffer((__gm__ half*)inputA, M * K);
        bGlobal.SetGlobalBuffer((__gm__ half*)inputB, K * N);
        cGlobal.SetGlobalBuffer((__gm__ half*)output, M * N);

        pipe.InitBuffer(inQueueA, 2, K * sizeof(half));
        pipe.InitBuffer(inQueueB, 2, K * sizeof(half));
        pipe.InitBuffer(outQueueC, 2, N * sizeof(half));
    }

    __aicore__ inline void Process() {
        for (uint32_t i = 0; i < M; i++) {
            LoadRow(i);
            ComputeRow(i);
            StoreRow(i);
        }
    }

private:
    __aicore__ inline void LoadRow(uint32_t row) {
        LocalTensor<half> aLocal = inQueueA.AllocTensor<half>();
        DataCopy(aLocal, aGlobal[row * K], K);
        inQueueA.EnQue(aLocal);

        LocalTensor<half> bLocal = inQueueB.AllocTensor<half>();
        DataCopy(bLocal, bGlobal[0], K * N);
        inQueueB.EnQue(bLocal);
    }

    __aicore__ inline void ComputeRow(uint32_t row) {
        LocalTensor<half> aLocal = inQueueA.DeQue<half>();
        LocalTensor<half> bLocal = inQueueB.DeQue<half>();
        LocalTensor<half> cLocal = outQueueC.AllocTensor<half>();

        Matmul(cLocal, aLocal, bLocal, N);
        SetAtomicAdd();

        outQueueC.EnQue(cLocal);
        inQueueA.FreeTensor(aLocal);
        inQueueB.FreeTensor(bLocal);
    }

    __aicore__ inline void StoreRow(uint32_t row) {
        LocalTensor<half> cLocal = outQueueC.DeQue<half>();
        DataCopy(cGlobal[row * N], cLocal, N);
        outQueueC.FreeTensor(cLocal);
    }

    TPipe pipe;
    TQue<QuePosition::VECIN, 2> inQueueA, inQueueB;
    TQue<QuePosition::VECOUT, 2> outQueueC;
    GlobalTensor<half> aGlobal, bGlobal, cGlobal;
    uint32_t M, N, K;
};

extern "C" __global__ __aicore__ void matmul_kernel(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c,
    uint32_t M, uint32_t N, uint32_t K
) {
    MatmulKernel op;
    op.Init(a, b, c, M, N, K);
    op.Process();
}

__aicpu__ void host_validate(uint32_t M, uint32_t N, uint32_t K) {
    // Host-side validation function running on AI CPU
    if (M == 0 || N == 0 || K == 0) {
        return;
    }
}

__vector__ void vector_postprocess(__gm__ uint8_t* data, uint32_t length) {
    // Vector compute function for post-processing
    GlobalTensor<half> gTensor;
    gTensor.SetGlobalBuffer((__gm__ half*)data, length);
}
